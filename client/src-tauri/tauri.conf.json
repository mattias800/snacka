{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snacka",
  "version": "0.1.0",
  "identifier": "app.snacka.client",
  "build": {
    "beforeDevCommand": "pnpm --dir ui dev --port 5173 --strictPort",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Snacka", "width": 1280, "height": 800, "minWidth": 480, "minHeight": 400 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
